# 대본 자동 생성용 (없으면 빈 템플릿만 생성됨)
ANTHROPIC_API_KEY=

# VOICEVOX 엔진 주소 (기본값 그대로 두면 로컬 실행 기준)
# https://voicevox.hiroshiba.jp 에서 앱 다운로드 후 실행하면 이 주소로 API가 열립니다
VOICEVOX_ENDPOINT=http://127.0.0.1:50021

# 화자(스피커) ID - VOICEVOX 앱에서 원하는 목소리를 고른 뒤 그 ID를 입력하세요
# (VOICEVOX 앱의 "話者" 선택 화면 또는 GET {endpoint}/speakers 로 확인)
VOICEVOX_SPEAKER_ID=3
